l__body\"><p class=\"pfb-modal__loading\">Loading the calendar&hellip;</p></div>\n<p class=\"pfb-modal__foot\">No cost, and nothing leaves the room. Prefer email? <a href=\"mailto:info@premierfamilybusiness.com\">info@premierfamilybusiness.com</a></p>\n</div>\n</dialog>\n<style>\n.pfb-modal{padding:0;border:0;margin:0;background:transparent;width:100%;height:100%;max-width:none;max-height:none;display:none;align-items:center;justify-content:center}\n.pfb-modal[open]{display:flex}\n.pfb-modal::backdrop{background:rgba(15,35,64,.62);animation:pfbFade .2s ease-out}\n.pfb-modal__panel{background:#fff;width:min(960px,calc(100vw - 48px));height:min(800px,calc(100dvh - 48px));display:flex;flex-direction:column;box-shadow:0 30px 80px rgba(15,35,64,.35);animation:pfbIn .28s cubic-bezier(.23,1,.32,1)}\n.pfb-modal__head{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;padding:28px 32px 20px;border-bottom:1px solid #E6E2D9}\n.pfb-modal__eb{margin:0 0 8px;font:600 12px/1.4 Poppins,sans-serif;letter-spacing:2.2px;text-transform:uppercase;color:#5F6674}\n.pfb-modal__title{margin:0;font:400 30px/1.15 Newsreader,Georgia,serif;letter-spacing:-.5px;color:#193153}\n.pfb-modal .pfb-modal__close{flex:none;width:44px;height:44px;display:grid;place-items:center;border:1px solid #E6E2D9!important;background:#fff!important;color:#193153!important;font-size:24px;line-height:1;cursor:pointer;border-radius:0!important;padding:0!important;transition:background-color .15s ease-out}\n.pfb-modal .pfb-modal__close:hover,.pfb-modal .pfb-modal__close:focus{background:#F7F6F2!important;color:#193153!important}\n.pfb-modal__close:focus-visible{outline:2px solid #193153;outline-offset:2px}\n.pfb-modal__body{flex:1;position:relative;min-height:0}\n.pfb-modal__body iframe{position:absolute;inset:0;width:100%;height:100%;border:0;background:transparent}\n.pfb-modal__loading{position:absolute;inset:0;display:grid;place-items:center;margin:0;font:400 14px Poppins,sans-serif;color:#5F6674}\n.pfb-modal__foot{margin:0;padding:14px 32px;border-top:1px solid #E6E2D9;font:400 13px/1.5 Poppins,sans-serif;color:#5F6674}\n.pfb-modal__foot a{color:#193153;text-decoration:underline;text-underline-offset:2px}\nhtml.pfb-modal-open{overflow:hidden}\n@keyframes pfbIn{from{opacity:0;transform:translateY(12px) scale(.985)}to{opacity:1;transform:none}}\n@keyframes pfbFade{from{opacity:0}to{opacity:1}}\n@media (max-width:767px){.pfb-modal__panel{width:100vw;height:100dvh}.pfb-modal__head{padding:20px 20px 14px}.pfb-modal__title{font-size:24px}.pfb-modal__foot{padding:12px 20px}}\n@media (prefers-reduced-motion:reduce){.pfb-modal__panel,.pfb-modal::backdrop{animation:none}}\n</style>\n<script>\n(function(){\n  if (window.__pfbBook) return; window.__pfbBook = true;\n  var SRC = 'https://meetings.hubspot.com/premier-family-business-consulting/exploratory-meeting?embed=true';\n  var d = document.getElementById('pfb-book'); if (!d) return;\n  var last = null;\n  function open(){\n    if (typeof d.showModal !== 'function') { window.open(SRC.split('?')[0], '_blank', 'noopener'); return; }\n    if (!d.querySelector('iframe')) {\n      var f = document.createElement('iframe');\n      f.src = SRC; f.title = 'Schedule an exploratory meeting with Premier';\n      d.querySelector('.pfb-modal__body').appendChild(f);\n    }\n    last = document.activeElement;\n    d.showModal();\n    document.documentElement.classList.add('pfb-modal-open');\n  }\n  function closed(){\n    if (!document.documentElement.classList.contains('pfb-modal-open')) return;\n    document.documentElement.classList.remove('pfb-modal-open');\n    if (last && last.focus) last.focus();\n  }\n  new MutationObserver(function(){ if (!d.open) closed(); }).observe(d, {attributes:true, attributeFilter:['open']});\n  d.addEventListener('close', closed);\n  d.addEventListener('click', function(e){ if (e.target === d) d.close(); });\n  d.querySelector('.pfb-modal__close').addEventListener('click', function(){ d.close(); });\n  document.addEventListener('click', function(e){\n    var a = e.target.closest && e.target.closest('a[href*=\"meetings.hubspot.com\"], a[href$=\"#schedule\"]');\n    if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;\n    e.preventDefault(); open();\n  });\n  if (location.hash === '#schedule') open();\n})();\n</script>"},"elements":[],"widgetType":"html"}],"isInner":false}]