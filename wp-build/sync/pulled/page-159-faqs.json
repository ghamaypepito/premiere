ments":[{"id":"d38b24c","elType":"widget","settings":{"title":"How long does BEG take?","header_size":"h3","title_color":"#193153","align":"","typography_typography":"custom","typography_font_family":"Newsreader","typography_font_size":{"unit":"px","size":22,"sizes":[]},"typography_font_weight":"400","typography_line_height":{"unit":"em","size":1.12,"sizes":[]},"typography_letter_spacing":{"unit":"px","size":0,"sizes":[]},"typography_font_size_mobile":{"unit":"px","size":19,"sizes":[]}},"elements":[],"widgetType":"heading"},{"id":"bae507a","elType":"widget","settings":{"editor":"<p>One year of monthly council and board facilitation, plus a half-day family team building session and a half-day family constitution review.</p>","text_color":"#3E4756","align":"","typography_typography":"custom","typography_font_family":"Poppins","typography_font_size":{"unit":"px","size":15.5,"sizes":[]},"typography_font_weight":"400","typography_line_height":{"unit":"em","size":1.7,"sizes":[]}},"elements":[],"widgetType":"text-editor"}],"isInner":true}],"isInner":true}],"isInner":true}],"isInner":false},{"id":"1714ea0","elType":"container","settings":{"content_width":"boxed","flex_direction":"column","flex_gap":{"unit":"px","size":0,"column":"0","row":"0","isLinked":true},"padding":{"unit":"px","top":"0","right":"24","bottom":"0","left":"24","isLinked":false},"boxed_width":{"unit":"px","size":1200,"sizes":[]},"padding_tablet":{"unit":"px","top":"0","right":"32","bottom":"0","left":"32","isLinked":false},"padding_mobile":{"unit":"px","top":"0","right":"22","bottom":"0","left":"22","isLinked":false}},"elements":[{"id":"430d680","elType":"widget","settings":{"html":"<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How do we get started with Premier?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Book an exploratory meeting. We listen to what is happening in the family and the business, in confidence. From there we offer a complimentary family-focused discussion, and then agree the right program and scope with you.\"}},{\"@type\":\"Question\",\"name\":\"Which program is right for our family?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Most families begin with Family Enterprise Planning, which covers succession, ownership and family culture. Organizational Systems Effectiveness and Key Process Management Consulting strengthen the business itself, and Building Effective Governance keeps the family council and board working after the plan is signed.\"}},{\"@type\":\"Question\",\"name\":\"What is Family Enterprise Planning?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"FEP is a planning process for families in business. It first strengthens the family culture, then clarifies policies and direction. It has four main processes: family culture building, ownership succession planning, leadership succession planning and family financial planning. The program is designed to leave a lasting legacy of sustainability across generations.\"}},{\"@type\":\"Question\",\"name\":\"How long does the FEP process take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"About 196 hours of total process time, roughly 24.5 days, from family orientation to the ceremonial signing. The largest parts are leadership succession planning (about 124 hours), financial planning (about 114 hours), and ownership succession planning and family culture building (about 60 hours each).\"}},{\"@type\":\"Question\",\"name\":\"What is Organizational Systems Effectiveness?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"OSE is a change-management service model for organizations seeking sustainable relevance. It integrates leadership and organizational development with a strategy- and core-competency-based people system, built around leadership development and a cohesive team that can champion change.\"}},{\"@type\":\"Question\",\"name\":\"How long does OSE take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"OSE is built from modules: guided meetings and coaching of about two hours per key person, a one-day leadership workshop, a one-day teambuilding for key leaders, enterprise strategic planning over about 2.5 days, and about one day of core competencies modeling.\"}},{\"@type\":\"Question\",\"name\":\"What is Key Process Management Consulting?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"KPMC helps growing enterprises and family businesses that are scaling up to a more ambitious level of operations. It combines a strategy review, a leadership review and hands-on management of the key business processes.\"}},{\"@type\":\"Question\",\"name\":\"How long does KPMC take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Twelve months. The strategy and leadership reviews happen in the first month. Process assessment runs over the first three months, design and development over the next three to four, and execution over the last five to six. Sessions run weekly for Cebu-based clients, and three days every two weeks for clients outside Cebu.\"}},{\"@type\":\"Question\",\"name\":\"What is Building Effective Governance?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"BEG helps families in business establish their governance structures and systems, professionalizing the family business for growth and generational wealth. A Premier consultant joins the family and business systems as facilitator, coach, technical adviser and change catalyst.\"}},{\"@type\":\"Question\",\"name\":\"What does Premier commit to in BEG?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"One year of monthly family council meeting facilitation and guidance, and one year of monthly board of directors facilitation and guidance, each with the option of a pre-meeting consultation.\"}},{\"@type\":\"Question\",\"name\":\"How long does BEG take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"One year of monthly council and board facilitation, plus a half-day family team building session and a half-day family constitution review.\"}}]}</script>"},"elements":[],"widgetType":"html"}],"isInner":false},{"id":"ce2e394","elType":"container","settings":{"content_width":"boxed","flex_direction":"column","flex_gap":{"unit":"px","size":0,"column":"0","row":"0","isLinked":true},"padding":{"unit":"px","top":"144","right":"24","bottom":"0","left":"24","isLinked":false},"boxed_width":{"unit":"px","size":1200,"sizes":[]},"padding_tablet":{"unit":"px","top":"108","right":"32","bottom":"0","left":"32","isLinked":false},"padding_mobile":{"unit":"px","top":"64","right":"22","bottom":"0","left":"22","isLinked":false}},"elements":[],"isInner":false},{"id":"a19392c","elType":"container","settings":{"content_width":"boxed","flex_direction":"column","flex_gap":{"unit":"px","size":0,"column":"0","row":"0","isLinked":true},"padding":{"unit":"px","top":"0","right":"24","bottom":"144","left":"24","isLinked":false},"boxed_width":{"unit":"px","size":1200,"sizes":[]},"padding_tablet":{"unit":"px","top":"0","right":"32","bottom":"108","left":"32","isLinked":false},"padding_mobile":{"unit":"px","top":"0","right":"22","bottom":"64","left":"22","isLinked":false}},"elements":[{"id":"4e4215d","elType":"container","settings":{"content_width":"full","flex_direction":"row","flex_gap":{"unit":"px","size":40,"column":"40","row":"40","isLinked":true},"padding":{"unit":"px","top":"80","right":"88","bottom":"80","left":"88","isLinked":false},"flex_direction_mobile":"column","flex_align_items":"center","flex_justify_content":"space-between","flex_wrap":"nowrap","background_background":"classic","background_color":"#F7F6F2","padding_mobile":{"unit":"px","top":"40","right":"24","bottom":"40","left":"24","isLinked":false}},"elements":[{"id":"009ecae","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_gap":{"unit":"px","size":14,"column":"14","row":"14","isLinked":true},"padding":{"unit":"px","top":"0","rig