{
  "name": "premier-visibility",
  "version": "3.0.0",
  "private": true,
  "description": "SEO/AEO change tracking, uptime, maintenance and plugin updates for premierfamilybusiness.com, on Cloudflare Workers + D1.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --zip",
    "dev": "npm run build && wrangler dev --local --persist-to .data --test-scheduled",
    "test": "npm run build && node --test test/*.test.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.162.0"
  }
}
